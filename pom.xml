<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.quickexport</groupId>
  <artifactId>sqldeveloper-quick-export-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>SQL Developer Quick Export (parent)</name>
  <description>One-click CSV/XLSX export from the SQL Developer query result grid. Not affiliated with Oracle.</description>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>

  <properties>
    <!-- Matches the JDK bundled with SQL Developer 24.3.1 (Java 17). -->
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.build.outputTimestamp>2026-01-01T00:00:00Z</project.build.outputTimestamp>

    <poi.version>5.3.0</poi.version>
    <junit.version>5.11.3</junit.version>
  </properties>

  <!-- core is always built; it has no Oracle dependencies (CI builds only this). -->
  <modules>
    <module>core</module>
  </modules>

  <profiles>
    <!--
      The SQL Developer integration compiles against jars from a local SQL Developer
      install. It is only built when -Dsqldev.home=... is given, so CI and contributors
      without an install can still build and test core.
    -->
    <profile>
      <id>sqldeveloper</id>
      <activation>
        <property>
          <name>sqldev.home</name>
        </property>
      </activation>
      <modules>
        <module>extension</module>
      </modules>
    </profile>
  </profiles>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.apache.poi</groupId>
        <artifactId>poi-ooxml</artifactId>
        <version>${poi.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.2</version>
          <configuration>
            <systemPropertyVariables>
              <!-- POI logs through the log4j API; no implementation is wanted in tests. -->
              <log4j2.statusLoggerLevel>OFF</log4j2.statusLoggerLevel>
            </systemPropertyVariables>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.4.2</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>3.6.0</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
