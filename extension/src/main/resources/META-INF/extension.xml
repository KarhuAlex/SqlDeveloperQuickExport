<?xml version="1.0" encoding="UTF-8" ?>
<extension xmlns="http://jcp.org/jsr/198/extension-manifest"
           id="dev.quickexport.sqldeveloper"
           version="${extension.version}"
           esdk-version="1.0">
  <name>Quick Export</name>
  <owner>SqlDeveloperQuickExport contributors</owner>
  <!--
    A service feature that is reloaded at start-up once it has been used, like Oracle's own
    optional extensions (snippet, scheduler, ssh). Without a feature the IDE keeps the
    extension in a lazy state and never runs its addin.
  -->
  <feature id="dev.quickexport.sqldeveloper" xmlns="http://xmlns.oracle.com/ide/extension">
    <category-id>db-category</category-id>
    <name>Quick Export</name>
    <description>One-click CSV and Excel export from the query result grid</description>
    <type>
      <service can-user-disable="true" reload-if-used="true"/>
    </type>
  </feature>
  <hooks>
    <jdeveloper-hook xmlns="http://xmlns.oracle.com/jdeveloper/1013/extension">
      <addins>
        <addin>dev.quickexport.sqldev.QuickExportAddin</addin>
      </addins>
    </jdeveloper-hook>
  </hooks>
</extension>
