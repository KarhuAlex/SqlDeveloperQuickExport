<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.quickexport</groupId>
    <artifactId>sqldeveloper-quick-export-parent</artifactId>
    <version>0.2.0</version>
  </parent>

  <artifactId>quick-export-sqldeveloper</artifactId>
  <name>Quick Export SQL Developer integration</name>
  <description>Menu contribution and grid adapter. Compiled against jars of a local SQL Developer install.</description>

  <properties>
    <!--
      Directory of the SQL Developer install that contains ide/, sqldeveloper/ and jdk/
      (e.g. C:/sqldeveloper-24.3.1-x64/sqldeveloper). Pass it with -Dsqldev.home=...
      The jars are only referenced from there for compilation; they are never copied
      into this repository or into the built extension.
    -->
    <sqldev.home>${env.SQLDEV_HOME}</sqldev.home>

    <!-- SQL Developer wants a purely numeric extension version (no -SNAPSHOT). -->
    <extension.version>0.2.0</extension.version>
    <shaded.prefix>dev.quickexport.shaded</shaded.prefix>
  </properties>

  <dependencies>
    <dependency>
      <groupId>dev.quickexport</groupId>
      <artifactId>quick-export-core</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- Oracle jars: system scope, resolved from the local install only. -->
    <dependency>
      <groupId>local.sqldeveloper</groupId>
      <artifactId>oracle-ide</artifactId>
      <version>local</version>
      <scope>system</scope>
      <systemPath>${sqldev.home}/ide/extensions/oracle.ide.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>local.sqldeveloper</groupId>
      <artifactId>javax-ide</artifactId>
      <version>local</version>
      <scope>system</scope>
      <systemPath>${sqldev.home}/ide/lib/javax-ide.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>local.sqldeveloper</groupId>
      <artifactId>javatools</artifactId>
      <version>local</version>
      <scope>system</scope>
      <systemPath>${sqldev.home}/ide/lib/javatools.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>local.sqldeveloper</groupId>
      <artifactId>oracle-ide-webupdate</artifactId>
      <version>local</version>
      <scope>system</scope>
      <systemPath>${sqldev.home}/ide/extensions/oracle.ide.webupdate.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>local.sqldeveloper</groupId>
      <artifactId>oracle-sqldeveloper</artifactId>
      <version>local</version>
      <scope>system</scope>
      <systemPath>${sqldev.home}/sqldeveloper/extensions/oracle.sqldeveloper.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>local.sqldeveloper</groupId>
      <artifactId>oracle-jdeveloper-db-connection</artifactId>
      <version>local</version>
      <scope>system</scope>
      <systemPath>${sqldev.home}/jdev/extensions/oracle.jdeveloper.db.connection.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>local.sqldeveloper</groupId>
      <artifactId>dbtools-common</artifactId>
      <version>local</version>
      <scope>system</scope>
      <systemPath>${sqldev.home}/sqldeveloper/lib/dbtools-common.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>local.sqldeveloper</groupId>
      <artifactId>oracle-sqldeveloper-utils</artifactId>
      <version>local</version>
      <scope>system</scope>
      <systemPath>${sqldev.home}/sqldeveloper/extensions/oracle.sqldeveloper.utils.jar</systemPath>
    </dependency>
  </dependencies>

  <build>
    <finalName>quick-export-sqldeveloper-${project.version}</finalName>

    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>META-INF/extension.xml</include>
        </includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes>
          <exclude>META-INF/extension.xml</exclude>
        </excludes>
      </resource>
    </resources>

    <plugins>
      <!--
        One self-contained jar: our code, core and Apache POI (with its dependencies) under
        relocated package names so they cannot clash with libraries SQL Developer ships.
        Oracle's jars are not included (system scope is never shaded).
        SQL Developer extensions are OSGi bundles: the manifest names the bundles we use.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <!--
                Not relocated: org.openxmlformats, org.etsi, org.w3.x2000 and com.microsoft.schemas.
                XMLBeans' binary schema files (.xsb) store the original class names of these
                generated types, so after relocation XMLBeans falls back to generic objects and
                throws ClassCastException. The packages stay private to this bundle, which requires
                none of Oracle's POI bundles, so they cannot clash.
              -->
              <relocations>
                <relocation><pattern>org.apache.poi</pattern><shadedPattern>${shaded.prefix}.org.apache.poi</shadedPattern></relocation>
                <relocation><pattern>org.apache.xmlbeans</pattern><shadedPattern>${shaded.prefix}.org.apache.xmlbeans</shadedPattern></relocation>
                <relocation><pattern>org.apache.commons</pattern><shadedPattern>${shaded.prefix}.org.apache.commons</shadedPattern></relocation>
                <relocation><pattern>org.apache.logging</pattern><shadedPattern>${shaded.prefix}.org.apache.logging</shadedPattern></relocation>
                <relocation><pattern>com.graphbuilder</pattern><shadedPattern>${shaded.prefix}.com.graphbuilder</shadedPattern></relocation>
                <relocation><pattern>com.zaxxer</pattern><shadedPattern>${shaded.prefix}.com.zaxxer</shadedPattern></relocation>
              </relocations>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                    <exclude>**/module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                    <exclude>META-INF/maven/**</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
                  <resource>META-INF/LICENSES.txt</resource>
                  <file>src/legal/LICENSES.txt</file>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer">
                  <addHeader>false</addHeader>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <manifestEntries>
                    <Bundle-ManifestVersion>2</Bundle-ManifestVersion>
                    <Bundle-SymbolicName>dev.quickexport.sqldeveloper</Bundle-SymbolicName>
                    <Bundle-Name>Quick Export</Bundle-Name>
                    <Bundle-Version>${extension.version}</Bundle-Version>
                    <Bundle-ClassPath>.</Bundle-ClassPath>
                    <Require-Bundle>oracle.ide,oracle.javatools,oracle.javaxide,oracle.sqldeveloper,oracle.sqldeveloper.utils,oracle.jdeveloper.db.connection,oracle.ide.webupdate</Require-Bundle>
                  </manifestEntries>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- The Check for Updates > Install From Local File package: bundle.xml plus the jar. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.2.0</version>
        <executions>
          <execution>
            <id>install-bundle</id>
            <phase>package</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <property name="bundle.dir" value="${project.build.directory}/bundle"/>
                <mkdir dir="${bundle.dir}/META-INF"/>
                <copy file="${project.basedir}/src/bundle/bundle.xml" tofile="${bundle.dir}/META-INF/bundle.xml" overwrite="true">
                  <filterset>
                    <filter token="EXTENSION_VERSION" value="${extension.version}"/>
                  </filterset>
                </copy>
                <zip destfile="${project.build.directory}/quick-export-sqldeveloper-${extension.version}-install.zip">
                  <fileset dir="${bundle.dir}" includes="META-INF/bundle.xml"/>
                  <fileset dir="${project.build.directory}" includes="${project.build.finalName}.jar"/>
                </zip>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
